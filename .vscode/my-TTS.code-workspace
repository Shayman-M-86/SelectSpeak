{
	"folders": [
		{
			"path": ".."
		}
	],
	"settings": {
		"workbench.colorCustomizations": {
			"statusBar.background": "#088ea9"
		},
		// Python settings
		"python.analysis.autoSearchPaths": false,
		"python.analysis.indexing": false,
		"python.analysis.diagnosticMode": "openFilesOnly",
		"python.analysis.typeCheckingMode": "basic",
		"python.analysis.useLibraryCodeForTypes": false,
		"python.analysis.include": [
			"*.py",
			"src"
		],
		"python.analysis.exclude": [
			"**/node_modules/**",
			"**/.*",
			"**/__pycache__/**",
			".cache/**",
			".pytest_cache/**",
			".ruff_cache/**",
			".runtime/**",
			".venv/**",
			"dist/**",
			"native/**",
			"tests/**"
		],
		"python.analysis.diagnosticSeverityOverrides": {
			"reportMissingImports": "none"
		},
		"python.analysis.extraPaths": [
			"${workspaceFolder}/src"
		],
		// Disable C/C++ indexing and automatic static analysis for native code.
		"C_Cpp.intelliSenseEngine": "disabled",
		"C_Cpp.intelliSenseCacheSize": 0,
		"C_Cpp.codeAnalysis.runAutomatically": false,
		"C_Cpp.files.exclude": {
			"native/**": true,
			"**/node_modules/**": true,
			"**/.*": true,
			"**/__pycache__/**": true
		},
		// Hide caches and keep them out of VS Code's file watcher and search.
		"files.exclude": {
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true,
			"**/node_modules": true,
			"**/__pycache__": true,
			"**/.cache": true,
			"**/.pytest_cache": true,
			"**/.ruff_cache": true,
			"**/.mypy_cache": true,
			"**/.pytype": true,
			"**/.hypothesis": true,
			"**/.ipynb_checkpoints": true,
			"**/.tox": true,
			"**/.nox": true,
			"**/.venv": true,
			"**/.runtime": true,
			"**/.coverage": true,
			"**/.coverage.*": true,
			"**/htmlcov": true,
			"**/.eggs": true,
			"**/*.egg-info": true,
			"**/*.pyc": true,
			"**/*.pyo": true
		},
		"files.watcherExclude": {
			"**/node_modules/**": true,
			"**/__pycache__/**": true,
			"**/.cache/**": true,
			"**/.pytest_cache/**": true,
			"**/.ruff_cache/**": true,
			"**/.mypy_cache/**": true,
			"**/.pytype/**": true,
			"**/.hypothesis/**": true,
			"**/.ipynb_checkpoints/**": true,
			"**/.tox/**": true,
			"**/.nox/**": true,
			"**/.venv/**": true,
			"**/.eggs/**": true,
			"**/*.egg-info/**": true,
			"**/.runtime/**": true,
			"**/dist/**": true
		},
		"search.exclude": {
			"**/node_modules/**": true,
			"**/__pycache__/**": true,
			"**/.cache/**": true,
			"**/.pytest_cache/**": true,
			"**/.ruff_cache/**": true,
			"**/.mypy_cache/**": true,
			"**/.pytype/**": true,
			"**/.hypothesis/**": true,
			"**/.ipynb_checkpoints/**": true,
			"**/.tox/**": true,
			"**/.nox/**": true,
			"**/.venv/**": true,
			"**/.runtime/**": true,
			"**/htmlcov/**": true,
			"**/.eggs/**": true,
			"**/*.egg-info/**": true,
			"**/.coverage": true,
			"**/.coverage.*": true,
			"**/*.pyc": true,
			"**/*.pyo": true
		},
		"python.envFile": "${workspaceFolder}/.env",
		"python.terminal.activateEnvironment": true,
		"python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
		// Code Runner settings
		"code-runner.executorMap": {
			"python": "uv run python $fullFileName"
		},
		"code-runner.runInTerminal": true
	}
}
