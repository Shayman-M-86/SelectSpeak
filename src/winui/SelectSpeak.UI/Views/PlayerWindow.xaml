<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="SelectSpeak.UI.Views.PlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Mica tints the window from the desktop wallpaper behind it.  -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid
        x:Name="AppTitleBar"
        Grid.Row="0"
        Padding="12,0">

        <StackPanel
            Orientation="Horizontal"
            Spacing="6"
            VerticalAlignment="Center">

            <FontIcon
                Glyph="&#xE767;"
                FontSize="14" />

            <TextBlock
                Text="SelectSpeak"
                VerticalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />

            <ProgressBar
    x:Name="ActivityBar"
    Visibility="Collapsed"
    Width="72"
    Height="3"
    VerticalAlignment="Center"
    IsIndeterminate="True" />

        </StackPanel>
    </Grid>

    <Grid
        Grid.Row="1"
        Padding="8,2,8,0">

        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">

            <ScrollViewer
                x:Name="ReaderScroll"
                Padding="0,0,0,0"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">

                <!--  Paragraph spacing is a Margin on each Paragraph rather than
                      line spacing, so the spoken-word highlight stays the same
                      size wherever the word falls.  -->
                <RichTextBlock
                    x:Name="Reader"
                    Padding="12,8,12,8"
                    IsTextSelectionEnabled="False">

                    <Paragraph Margin="0,0,0,6">
                        SelectSpeak reads whatever you have selected out loud,
                        and this first paragraph is long enough to wrap onto a
                        second line so the highlight can be checked at a line
                        boundary.
                    </Paragraph>

                    <!--  A hanging indent aligns a wrapped bullet under its
                          text rather than under the bullet glyph.  -->
                    <Paragraph Margin="14,0,0,6" TextIndent="-14">
                        • This bullet is also deliberately long so that it
                        wraps onto a second display line for testing
                    </Paragraph>

                    <Paragraph Margin="14,0,0,6" TextIndent="-14">
                        • Second bullet is short
                    </Paragraph>

                    <Paragraph Margin="14,0,0,6" TextIndent="-14">
                        • Third bullet also wraps because it is written to
                        be long enough to spill over the width of the panel
                    </Paragraph>

                </RichTextBlock>

            </ScrollViewer>
        </Border>
    </Grid>

    <Grid
        Grid.Row="2"
        Padding="8,3,8,5">

        <!--  Transport on the left, settings pushed to the right edge.  -->
        <StackPanel
            Orientation="Horizontal"
            Spacing="8"
            HorizontalAlignment="Left">

            <Button
                x:Name="PlayPauseButton"
                Style="{StaticResource TransportButtonStyle}"
                MinWidth="96"
                HorizontalContentAlignment="Left"
                Click="OnPlayPause">
                <!--  A fixed MinWidth keeps the button the same size for both
                      labels, so switching between Playing and Paused never
                      shifts the Stop button beside it.  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE769;" FontSize="14" />
                    <TextBlock x:Name="PlayPauseLabel" Text="Paused" />
                </StackPanel>
            </Button>

            <Button
                x:Name="StopButton"
                Style="{StaticResource StopButtonStyle}"
                Foreground="#cb473b">
                <!--  A subtle-style button resolves its foreground from the
                      SubtleButtonForeground* resources, not the ButtonForeground*
                      ones, so these are the keys the visual states actually
                      read. Setting Foreground on the button cannot work: the
                      PointerOver state replaces it.  -->
                <Button.Resources>
                    <SolidColorBrush x:Key="SubtleButtonForegroundPointerOver" Color="#dc2a21" />
                    <SolidColorBrush x:Key="SubtleButtonForegroundPressed" Color="#ed2614" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                    <TextBlock Text="Stop" />
                </StackPanel>
            </Button>

        </StackPanel>

        <!--  Height comes from the shared style; only Width and the zeroed
              padding are specific to this one, to keep it square.  -->
        <Button
            x:Name="SettingsButton"
            Style="{StaticResource TransportButtonStyle}"
            HorizontalAlignment="Right"
            Width="26"
            Padding="0">
            <FontIcon Glyph="&#xE713;" FontSize="14" />
        </Button>
    </Grid>
</Grid>
</Window>