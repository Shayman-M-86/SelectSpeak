<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="SelectSpeak.UI.Views.PlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Mica tints the window from the desktop wallpaper behind it.  -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid
        x:Name="AppTitleBar"
        Grid.Row="0"
        Padding="12,0">

        <StackPanel
            Orientation="Horizontal"
            Spacing="6"
            VerticalAlignment="Center">

            <FontIcon
                Glyph="&#xE767;"
                FontSize="14" />

            <TextBlock
                Text="SelectSpeak"
                VerticalAlignment="Center"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />

            <ProgressBar
    x:Name="ActivityBar"
    Visibility="Collapsed"
    Width="72"
    Height="3"
    VerticalAlignment="Center"
    IsIndeterminate="True" />

        </StackPanel>
    </Grid>

    <Grid
        Grid.Row="1"
        Padding="8,2,8,0">

        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">

            <ScrollViewer
                x:Name="ReaderScroll"
                Padding="0,0,0,0"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto"
                ViewChanged="OnReaderScrolled">

                <!--  Paragraph spacing is a Margin on each Paragraph rather than
                      line spacing, so the spoken-word highlight stays the same
                      size wherever the word falls.  -->
                <RichTextBlock
                    x:Name="Reader"
                    Padding="12,8,12,8"
                    IsTextSelectionEnabled="False">

                    <!--  The resting state. set_text replaces this while there
                          is something to read and restores it when there is
                          not, so the wording is duplicated in PlaceholderText.
                          A bullet's hanging indent is applied in code, matching
                          the TextIndent used here.  -->
                    <Paragraph x:Name="ReaderPlaceholder" Margin="0,0,0,6">
                        Select some text and press the read shortcut.
                    </Paragraph>

                </RichTextBlock>

            </ScrollViewer>
        </Border>
    </Grid>

    <Grid
        Grid.Row="2"
        Padding="8,3,8,5">

        <!--  Transport on the left, settings pushed to the right edge.  -->
        <StackPanel
            Orientation="Horizontal"
            Spacing="8"
            HorizontalAlignment="Left">

            <!--  Both transport buttons start collapsed: nothing has been
                  read yet, so there is no playback to pause or stop.  -->
            <Button
                x:Name="PlayPauseButton"
                Style="{StaticResource TransportButtonStyle}"
                Visibility="Collapsed"
                MinWidth="96"
                HorizontalContentAlignment="Left"
                Click="OnPlayPause">
                <!--  A fixed MinWidth keeps the button the same size for both
                      labels, so switching between Playing and Paused never
                      shifts the Stop button beside it.  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE769;" FontSize="14" />
                    <TextBlock x:Name="PlayPauseLabel" Text="Paused" />
                </StackPanel>
            </Button>

            <Button
                x:Name="StopButton"
                Style="{StaticResource StopButtonStyle}"
                Visibility="Collapsed"
                Click="OnStop"
                Foreground="#cb473b">
                <!--  A subtle-style button resolves its foreground from the
                      SubtleButtonForeground* resources, not the ButtonForeground*
                      ones, so these are the keys the visual states actually
                      read. Setting Foreground on the button cannot work: the
                      PointerOver state replaces it.  -->
                <Button.Resources>
                    <SolidColorBrush x:Key="SubtleButtonForegroundPointerOver" Color="#dc2a21" />
                    <SolidColorBrush x:Key="SubtleButtonForegroundPressed" Color="#ed2614" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                    <TextBlock Text="Stop" />
                </StackPanel>
            </Button>

        </StackPanel>

        <!--  The read shortcut sits beside the gear, at the right edge. It is
              the only persistent message the player shows.  -->
        <StackPanel
            Orientation="Horizontal"
            Spacing="8"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">

            <TextBlock
                x:Name="ShortcutHint"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}" />

            <!--  Height comes from the shared style; only Width and the zeroed
                  padding are specific to this one, to keep it square.  -->
            <Button
                x:Name="SettingsButton"
                Style="{StaticResource TransportButtonStyle}"
                Click="OnSettings"
                Width="26"
                Padding="0">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
        </StackPanel>
    </Grid>
</Grid>
</Window>