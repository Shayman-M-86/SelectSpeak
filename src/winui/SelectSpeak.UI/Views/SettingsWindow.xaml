<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="SelectSpeak.UI.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <!--  Only this window uses these, so they live here rather than in
              App.xaml with the styles the player shares.  -->
        <Grid.Resources>

            <!--  One row of the list: a Fluent card holding a label and its
                  control, so rows keep a common height and inset however their
                  contents differ.  -->
            <Style x:Key="SettingCardStyle" TargetType="Border">
                <Setter Property="Background"
                        Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush"
                        Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="MinHeight" Value="48" />
            </Style>

            <!--  A group heading.  -->
            <Style x:Key="SettingGroupStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Foreground"
                        Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,12,0,4" />
            </Style>

            <!--  Each row is a two-column grid, so the control sits where the
                  column puts it. Aligning a ToggleSwitch inside a single cell
                  does not work: it keeps a fixed content column after the
                  track for its On/Off text, so the part you see never reaches
                  the edge you aligned it to.  -->
            <Style x:Key="SettingRowStyle" TargetType="Grid">
                <Setter Property="ColumnSpacing" Value="12" />
            </Style>

            <!--  With no On/Off text the switch still keeps its content column,
                  so it is given the track's own width. In an Auto column that
                  makes the control end exactly where the track does, flush with
                  the card's padding.  -->
            <Style x:Key="SettingToggleStyle" TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="52" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="12,0">

            <StackPanel
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">

                <FontIcon Glyph="&#xE713;" FontSize="14" />

                <TextBlock
                    Text="Settings"
                    VerticalAlignment="Center"
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="16,4,16,16"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">

            <!--  Groups follow how often a setting is touched: playback first,
                  then behaviour, with diagnostics last as a developer affordance.  -->
            <StackPanel>

                <TextBlock Text="Playback" Style="{StaticResource SettingGroupStyle}" />

                <!--  The picker sits under the label rather than beside it: a
                      control this wide in the right-hand column would squeeze
                      the hint into a narrow ragged column.  -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel>
                            <TextBlock Text="Voice" />
                            <TextBlock
                                Text="Used for everything read aloud."
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <!--  Grouped by engine, as the Tk menu is. Headings are
                              non-selectable items rather than a nested list,
                              which is what a ComboBox can express.  -->
                        <ComboBox
                            x:Name="VoicePicker"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="OnVoiceSelected" />

                        <!--  Shown when a voice will not load. Selecting one
                              that fails reverts to the previous voice, which
                              looks like a fault unless it says why.  -->
                        <InfoBar
                            x:Name="VoiceError"
                            IsOpen="False"
                            IsClosable="True"
                            Severity="Warning" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Behaviour" Style="{StaticResource SettingGroupStyle}" />

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Grid.Column="0">
                            <TextBlock Text="Hide when reading finishes" />
                            <TextBlock
                                Text="Keeps the player out of the way between reads."
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="AutoHideToggle"
                            Grid.Column="1"
                            Style="{StaticResource SettingToggleStyle}"
                            Toggled="OnAutoHideToggled" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Grid.Column="0">
                            <TextBlock Text="Always read the clipboard" />
                            <TextBlock
                                Text="Otherwise the selection is read, falling back to the clipboard."
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="ClipboardToggle"
                            Grid.Column="1"
                            Style="{StaticResource SettingToggleStyle}"
                            Toggled="OnClipboardToggled" />
                    </Grid>
                </Border>

                <TextBlock Text="Shortcuts" Style="{StaticResource SettingGroupStyle}" />

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Grid.Column="0">
                            <TextBlock Text="Read selection" />
                            <TextBlock
                                x:Name="HotkeyValue"
                                Text="Alt+S"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button
                            x:Name="HotkeyButton"
                            Grid.Column="1"
                            Content="Change"
                            VerticalAlignment="Center"
                            Click="OnCaptureHotkey" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Grid.Column="0">
                            <TextBlock Text="Capture text on screen" />
                            <TextBlock
                                x:Name="OcrHotkeyValue"
                                Text="Alt+D"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button
                            x:Name="OcrHotkeyButton"
                            Grid.Column="1"
                            Content="Change"
                            VerticalAlignment="Center"
                            Click="OnCaptureOcrHotkey" />
                    </Grid>
                </Border>

                <!--  Shown when a shortcut will not bind. A rejected one
                      reverts to the previous binding, which looks like the
                      button did nothing unless it says why.  -->
                <InfoBar
                    x:Name="HotkeyError"
                    Margin="0,8,0,0"
                    IsOpen="False"
                    IsClosable="True"
                    Severity="Warning" />

                <TextBlock Text="Advanced" Style="{StaticResource SettingGroupStyle}" />

                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Grid.Column="0">
                            <TextBlock Text="Speech diagnostics" />
                            <TextBlock
                                Text="Collects chunk timing while reading."
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="DebugToggle"
                            Grid.Column="1"
                            Style="{StaticResource SettingToggleStyle}"
                            Toggled="OnDebugToggled" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
