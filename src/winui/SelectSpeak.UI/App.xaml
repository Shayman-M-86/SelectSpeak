<Application x:Class="SelectSpeak.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Transport buttons: no fill until hover, and dulled content at
                  rest so the controls sit back until pointed at.  -->
            <!--  One control plane for every button on the transport row:
                  height, padding and resting colour all live here so the three
                  buttons cannot drift apart.  -->
            <Style x:Key="TransportButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Foreground"
                        Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="11,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  Stop shares the transport style; its colours come from the
                  SubtleButtonForeground* resources set on the button itself,
                  because those are what the visual states read.  -->
            <Style x:Key="StopButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource TransportButtonStyle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
