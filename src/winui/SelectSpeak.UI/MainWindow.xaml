<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SelectSpeak.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: the window is extended into it, so this row is draggable. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="40" Padding="14,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE767;" FontSize="14"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="SelectSpeak" VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}" />
                <ProgressRing x:Name="BusyRing" Width="14" Height="14"
                              IsActive="False" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="16,0,16,10"
                   TextWrapping="Wrap"
                   Style="{ThemeResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Waiting for SelectSpeak…" />

        <!-- Reader card -->
        <Border Grid.Row="2" Margin="16,0,16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6">
            <ScrollViewer x:Name="ReaderScroll" Padding="14,12"
                          VerticalScrollBarVisibility="Auto"
                          VerticalScrollMode="Auto">
                <RichTextBlock x:Name="Reader"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="False"
                               LineHeight="20"
                               Style="{ThemeResource BodyRichTextBlockStyle}" />
            </ScrollViewer>
        </Border>

        <!-- Transport -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    Margin="16,0,16,16" Spacing="8">
            <Button x:Name="ReadButton" Click="OnRead"
                    Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="12" />
                    <TextBlock Text="Read" />
                </StackPanel>
            </Button>
            <Button x:Name="PlayButton" Click="OnPlayPause" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="PlayIcon" Glyph="&#xE72C;" FontSize="12" />
                    <TextBlock x:Name="PlayLabel" Text="Replay" />
                </StackPanel>
            </Button>
            <Button x:Name="StopButton" Click="OnStop" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE73B;" FontSize="12" />
                    <TextBlock Text="Stop" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
