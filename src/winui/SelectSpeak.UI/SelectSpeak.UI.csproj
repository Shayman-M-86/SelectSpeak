<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>SelectSpeak.UI</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <!-- Unpackaged. Without this the app builds but crashes on launch,
         because WinUI otherwise expects MSIX package identity. -->
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <!--
    Windows file metadata, verified at release time by
    build-tools/tools/verify_windows_metadata.ps1 alongside SelectSpeak.exe and
    the native bridge. scripts/bump_version.ps1 owns Version; the rest are fixed.
  -->
  <PropertyGroup>
    <Version>0.1.3</Version>
    <!-- The SDK otherwise appends "+<commit sha>" to ProductVersion, which the
         release metadata check compares literally against the project version. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>SelectSpeak Project</Company>
    <Product>SelectSpeak</Product>
    <AssemblyTitle>SelectSpeak player</AssemblyTitle>
    <Description>SelectSpeak text-to-speech player</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250916003" />
  </ItemGroup>
</Project>
